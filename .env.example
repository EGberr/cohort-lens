# Claude agent (optional). Without it, the app runs the deterministic offline analyst.
ANTHROPIC_API_KEY=

# Backend settings (all optional)
COHORT_MODEL=claude-opus-5-5
COHORT_EFFORT=medium
COHORT_USE_RERANKER=true
COHORT_CORS_ORIGINS=["http://localhost:3000"]

# Frontend: where Next.js proxies /api
BACKEND_URL=http://127.0.0.1:8000
